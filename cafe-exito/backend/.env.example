APP_NAME="Cafe Exito API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- PostgreSQL (lihat docs/DEVELOPMENT_GUIDE.md). Jangan commit kata sandi asli. ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cafe_exito
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# API-only: tanpa session/cache/queue berbasis database.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# --- Sanctum (bearer token) ---
SANCTUM_TOKEN_EXPIRATION_MINUTES=720

# --- CORS: daftar origin frontend dipisah koma. Kosong = semua origin ditolak. ---
# Contoh lokal: CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Table-Token,X-Request-Id
CORS_EXPOSED_HEADERS=X-Request-Id
CORS_MAX_AGE=600
CORS_SUPPORTS_CREDENTIALS=false

# --- Frontend (untuk membangun tautan QR meja) ---
FRONTEND_URL=http://localhost:5173
FRONTEND_QR_PATH=/order?t={token}

# --- Akun awal seeder (WAJIB diganti; jangan dipakai di produksi) ---
SEED_DEFAULT_PASSWORD=ganti-saya-123
