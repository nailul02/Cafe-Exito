# Alamat backend Laravel (tanpa slash di akhir). Lihat docs/DEVELOPMENT_GUIDE.md
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true  = semua data berasal dari src/mocks (backend tidak diperlukan)
# false = semua data berasal dari backend lewat Axios
VITE_USE_MOCK=true

# Interval polling antrean/status dalam milidetik (kontrak: 3000-5000)
VITE_POLL_INTERVAL_MS=4000


# Tampilkan catatan "asumsi/tanpa desain Figma" pada layar terkait (docs/IMPLEMENTATION_STATUS.md)
VITE_SHOW_DEV_NOTES=true
